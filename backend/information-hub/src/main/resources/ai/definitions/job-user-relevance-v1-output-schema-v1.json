{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:information-platform:analysis:JOB_USER_RELEVANCE:1:output",
  "title": "JOB_USER_RELEVANCE_V1 Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "relevanceScore",
    "confidence",
    "summary",
    "positiveSignals",
    "negativeSignals",
    "attentionPoints",
    "matchedPreferences",
    "unmatchedPreferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "relevanceScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "positiveSignals": {
      "$ref": "#/$defs/signalArray"
    },
    "negativeSignals": {
      "$ref": "#/$defs/signalArray"
    },
    "attentionPoints": {
      "$ref": "#/$defs/signalArray"
    },
    "matchedPreferences": {
      "$ref": "#/$defs/signalArray"
    },
    "unmatchedPreferences": {
      "$ref": "#/$defs/signalArray"
    }
  },
  "$defs": {
    "signalArray": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  }
}
