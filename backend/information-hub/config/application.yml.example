# Copy this file to application.yml in the same directory.
# application.yml contains credentials and must not be committed.

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:13306/information_hub_dev?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useUnicode=true&characterEncoding=UTF-8
    username: information_hub_dev
    password: CHANGE_ME_DEV_DATABASE_PASSWORD
  flyway:
    enabled: false
    locations: classpath:db/migration
    validate-on-migrate: true
    clean-disabled: true

information-hub:
  collector-api:
    token: CHANGE_ME_COLLECTOR_TOKEN
    max-request-bytes: 2097152

  ai:
    batch:
      worker-enabled: false
      worker-initial-delay: 3s
      worker-fixed-delay: 1s
    preview:
      hmac-secret: CHANGE_ME_RANDOM_PREVIEW_HMAC_SECRET_AT_LEAST_32_BYTES

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
