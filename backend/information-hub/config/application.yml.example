# 将本文件复制为同目录 application.yml 后使用。
# application.yml 会包含密码、Token 和 API Key，已被 Git 忽略，禁止提交。
# 每项的完整来源、格式和安全说明见 ../CONFIGURATION.md。

spring:
  datasource:
    # 来源：数据库管理员或 deploy 配置；格式：jdbc:mysql://主机:端口/库名?参数。
    url: jdbc:mysql://127.0.0.1:13306/information_hub_dev?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useUnicode=true&characterEncoding=UTF-8
    # 来源：数据库管理员创建并授权的账号。
    username: information_hub_dev
    # 来源：数据库管理员或部署 Secret；请替换占位符，禁止提交真实密码。
    password: CHANGE_ME_DEV_DATABASE_PASSWORD
  flyway:
    # 本地普通启动默认 false；需要应用启动时执行 Migration 才改为 true。
    enabled: false
    # 以下三项由项目固定，一般不修改。
    locations: classpath:db/migration
    validate-on-migrate: true
    clean-disabled: true

server:
  servlet:
    session:
      cookie:
        # 本地 HTTP 使用 false；生产 HTTPS 必须为 true。
        secure: false

information-hub:
  collector-api:
    # 自行生成随机 Token，并与 Collector 的 collector_token 配成相同值。
    token: CHANGE_ME_RANDOM_COLLECTOR_TOKEN
    # 单位字节；2097152 = 2 MiB。
    max-request-bytes: 2097152

  identity:
    bootstrap:
      # 仅账号表为空时创建一次；用户名和显示名由管理员确定。
      username: CHANGE_ME_BOOTSTRAP_USERNAME
      # 由管理员生成的初始密码；只保留摘要，禁止提交明文。
      password: CHANGE_ME_BOOTSTRAP_PASSWORD
      display-name: 平台管理员
      # IANA 时区名称；可从 IANA tz database 支持列表中选择。
      timezone: Asia/Shanghai

  ai:
    batch:
      # Provider 配置完整且确实允许产生模型调用费用后才能开启。
      worker-enabled: false
      # Spring Duration 格式示例：200ms、3s、1m。
      worker-initial-delay: 3s
      worker-fixed-delay: 1s
    schedule:
      # 全局 Dispatcher 默认启用；每条业务 Schedule 创建后仍默认关闭。
      dispatcher-enabled: true
      dispatcher-initial-delay: 5s
      dispatcher-fixed-delay: 30s
      misfire-grace: 5m
      max-schedules-per-poll: 100
    preview:
      # 自行生成至少 32 个 UTF-8 字节的随机秘密；它不是 Provider API Key。
      hmac-secret: CHANGE_ME_RANDOM_PREVIEW_HMAC_SECRET_AT_LEAST_32_BYTES

    provider:
      # Base URL、API Key 和模型 ID 均从所选 Provider 的官方文档/控制台获取。
      enabled: false
      # 通常包含 /v1；后端会自动追加 /chat/completions；格式示例：https://provider.example.com/v1。
      base-url: ""
      # 推荐通过 INFORMATION_HUB_AI_API_KEY 环境变量提供，不要在此保留真实值。
      api-key: ""
      # 填写 Provider 官方模型列表中的模型 ID，而不是页面展示名称；格式示例：provider-model-id。
      model: ""
      timeout: 2m

      # Provider 配置允许范围为 1 至 5000；当前 JOB V2 使用 5000。
      max-output-tokens: 5000

mybatis-plus:
  configuration:
    # 项目固定：snake_case 数据库列自动映射 camelCase Java 字段。
    map-underscore-to-camel-case: true
