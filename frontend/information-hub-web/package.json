{
  "name": "information-hub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ./e2e/run-e2e.mjs",
    "test:e2e:phase3": "node ./e2e/run-phase3-e2e.mjs",
    "test:e2e:phase4": "node ./e2e/run-phase4-e2e.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.2.7",
    "axios-mock-adapter": "2.1.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
