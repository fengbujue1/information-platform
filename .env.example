# Optional Information Hub backend overrides
INFORMATION_HUB_DB_URL=jdbc:mysql://127.0.0.1:13306/information_hub_dev
INFORMATION_HUB_DB_USERNAME=information_hub_dev
INFORMATION_HUB_DB_PASSWORD=replace-with-local-password
INFORMATION_HUB_FLYWAY_ENABLED=false
INFORMATION_HUB_COLLECTOR_MAX_REQUEST_BYTES=2097152

# Shared backend and Collector token
INFORMATION_HUB_COLLECTOR_TOKEN=replace-with-local-token

# Optional BOSS Collector overrides
INFORMATION_HUB_ENABLED=false
INFORMATION_HUB_URL=http://127.0.0.1:8080/api/v1/collector/items
INFORMATION_HUB_CONNECT_TIMEOUT_SECONDS=3
INFORMATION_HUB_READ_TIMEOUT_SECONDS=10
