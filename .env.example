# Information Hub
INFORMATION_HUB_URL=http://localhost:8080
INFORMATION_HUB_TOKEN=replace-with-local-token

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=information_hub
MYSQL_USERNAME=information_hub
MYSQL_PASSWORD=replace-with-local-password

# BOSS Collector integration
INFORMATION_HUB_ENABLED=false
INFORMATION_HUB_TIMEOUT_SECONDS=15
INFORMATION_HUB_OUTBOX_DIR=./data/outbox
