# ==================================================
# Secrets / local environment
# ==================================================
.env
.env.*
!.env.example

*.key
*.pem
*.p12
*.pfx
secrets/

# ==================================================
# IDE
# ==================================================
.idea/
*.iml

.vscode/
.project
.classpath
.settings/

# ==================================================
# Operating system
# ==================================================
.DS_Store
Thumbs.db
Desktop.ini

# ==================================================
# Java / Maven
# Maven Wrapper 必须提交，所以不要忽略 .mvn、mvnw、mvnw.cmd
# ==================================================
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
!**/.mvn/wrapper/maven-wrapper.jar

# ==================================================
# Gradle，暂时保留兼容
# ==================================================
**/.gradle/
**/build/

# ==================================================
# Python
# ==================================================
**/__pycache__/
**/*.py[cod]
**/*.pyo

**/.venv/
**/venv/
**/env/

**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# ==================================================
# Node / Vue
# pnpm-lock.yaml、package.json 必须提交
# ==================================================
**/node_modules/
**/dist/
**/.vite/
**/.next/
**/coverage/
**/.nuxt/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

